# Copy this file to .env and change the values for local use.

FLASK_SECRET_KEY=change-this-local-flask-secret
FLASK_DEBUG=0

# HMAC secret used by app.py and AddAPayRaiseServer.py.
HMAC_SECRET=change-this-local-hmac-secret

# AES key used by Encryption.py.
# AES_KEY must be 16, 24, or 32 characters.
# Encryption.py generates a new random IV for each encrypted value.
AES_KEY=0123456789abcdef0123456789abcdef