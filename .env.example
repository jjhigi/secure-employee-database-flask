# Copy this file to .env for local use.
# Do not commit the real .env file to GitHub.

# Flask session secret.
FLASK_SECRET_KEY=change-this-local-flask-secret

# Use 0 for normal local use. Use 1 only when actively debugging.
FLASK_DEBUG=0

# HMAC secret used for authenticated socket messages.
HMAC_SECRET=change-this-local-hmac-secret

# AES key used for encrypted employee and pay raise fields.
# Must be 16, 24, or 32 characters after UTF-8 encoding.
# The app generates a new random IV for each encrypted value.
AES_KEY=0123456789abcdef0123456789abcdef
